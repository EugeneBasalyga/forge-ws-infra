DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=forge
DB_PORT=5432
DB_CONTAINER_NAME=forge-postgresql

# Services run in pm2 on the host, so they reach the docker database via localhost
DB_CONNECTION_STRING=postgresql://postgres:postgres@localhost:5432/forge

#PLACE ALL ENVS FOR EVERY SERVICE_APP HERE!!!
#START NAMES OF SERVICE NAME, FOR EXAMPLE: AUTH_PORT, PROFILE_VERSION, NOTIFICATION_API_KEY

SERVICE_PORT=1111
SERVICE_VERSION=1
SERVICE_DOMAIN_URL=http://localhost:1111
# Token lifetimes are in seconds
SERVICE_JWT_ACCESS_TOKEN_SECRET=access-token-secret
SERVICE_JWT_ACCESS_TOKEN_EXPIRES_IN=3600
SERVICE_JWT_REFRESH_TOKEN_SECRET=refresh-token-secret
SERVICE_JWT_REFRESH_TOKEN_EXPIRES_IN=2592000
